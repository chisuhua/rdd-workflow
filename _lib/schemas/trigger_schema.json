{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rdd-workflow.dev/schemas/trigger_schema.json",
  "title": "Trigger Registry",
  "description": "Schema for .rddf/state/triggers.json — the persistent trigger registry.",
  "type": "object",
  "required": ["version", "triggers"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. v1: initial."
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "config", "rate_limit", "enabled"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["cron", "fs", "git", "webhook"]},
          "config": {"type": "object"},
          "rate_limit": {"type": "integer", "minimum": 0},
          "enabled": {"type": "boolean"},
          "created_at": {"type": "string", "format": "date-time"},
          "last_fire_at": {"type": ["string", "null"], "format": "date-time"},
          "token_bucket": {"type": "number"}
        }
      }
    }
  }
}
