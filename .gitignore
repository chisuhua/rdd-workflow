# AI agent framework state directories (sisyphus / omo / opencode)
# These contain ephemeral session state, plans, and run-continuation data
# that should not be version-controlled.
.sisyphus/
.omo/
.opencode/

# spec-workflow runtime state and worktree directories
# .rddf/plans/ is tracked; .rddf/state/ and .rddf/wt/ are runtime-only
.rddf/state/
.rddf/wt/
.rddf/detectors/
.rddf/actions/
.rddf/issues/

# rdd-quick 曾把状态写到 skills/ 下（根解析 bug，已修）；保留兜底
skills/.rddf/

# Legacy .spec-workflow/ runtime state (migrated to .rddf/ in v2.0)
.spec-workflow/

# Legacy .zcf/ (migrated to .rddf/ in v2.0)
.zcf/

# bats test temp directories (auto-created by bats, not for commit)
.bats-tmp/

# Python __pycache__ directories
__pycache__/
# understand-anything tool cache
.understand-anything/

# v2.0.3: dev tooling artifacts
.mcp.json
.opencode.json
node_modules/
pnpm-lock.yaml

# .rddf/roadmap-migrate-backup-* 是 destructive 操作的 backup 副产物, 不该 commit
.rddf/.roadmap-migrate-backup-*
# .rddf/roadmap/.backup/ 是 populate-roadmap-from-arch 的 backup 目录
.rddf/roadmap/.backup/

# rdd-workflow: git.openspec_tracked=false — keep the *archive* out of git.
# ADR-0036 (2026-11-17 修订) 把该开关限定为「归档路径」维度 ⇒ 只排除 openspec/changes/，
# openspec/specs/ + config.yaml 是可跟踪的契约面（CI 上 openspec validate 需要它们）。
openspec/changes/
# 归档生成的 schema 副本：CLI 有内建 defaultSchema，无需入库（避免与上游 schema 漂移）。
openspec/schemas/

# rdd-workflow: feedback appender + parallel phase race conditions create ephemeral lock files
.rddf/improvements/*.lock
.rddf/improvements/.feedback-counters.json
# rdd-workflow: roadmap AUTO-SPRINT writer 的 fcntl 锁文件（_lib/roadmap_sprint.py:270
# 用 Path(roadmap.md).with_suffix(".lock") ⇒ 每次 planner sync 都留下一个）
.rddf/roadmap.lock

# 静态检查工具的本地缓存 (跑 ./test.sh --gates 会生成)
.ruff_cache/
.mypy_cache/
