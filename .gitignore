# AI agent framework state directories (sisyphus / omo / opencode)
# These contain ephemeral session state, plans, and run-continuation data
# that should not be version-controlled.
.sisyphus/
.omo/
.opencode/

# spec-workflow runtime state and worktree directories
# .rddf/plans/ is tracked; .rddf/state/ and .rddf/wt/ are runtime-only
.rddf/state/
.rddf/wt/
.rddf/detectors/
.rddf/actions/
.rddf/issues/

# Legacy .spec-workflow/ runtime state (migrated to .rddf/ in v2.0)
.spec-workflow/

# Legacy .zcf/ (migrated to .rddf/ in v2.0)
.zcf/

# bats test temp directories (auto-created by bats, not for commit)
.bats-tmp/

# Python __pycache__ directories
__pycache__/
# understand-anything tool cache
.understand-anything/

# v2.0.3: dev tooling artifacts
.mcp.json
.opencode.json
node_modules/
pnpm-lock.yaml

# .rddf/roadmap-migrate-backup-* 是 destructive 操作的 backup 副产物, 不该 commit
.rddf/.roadmap-migrate-backup-*
# .rddf/roadmap/.backup/ 是 populate-roadmap-from-arch 的 backup 目录
.rddf/roadmap/.backup/
