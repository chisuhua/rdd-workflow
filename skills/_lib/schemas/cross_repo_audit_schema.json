{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": {
    "const": "v1",
    "description": "Schema metadata version per ADR-0016. Const v1 = initial baseline. Future bumps require version-migration flow."
  },
  "$id": "https://rdd-workflow.local/schemas/cross_repo_audit_schema.json",
  "title": "Cross-repo Audit v1 (ADR-0030)",
  "description": "Schema for .rddf/state/.cross-repo-audit.jsonl (newline-delimited JSON). Records every cross-repo decision (RFC initiation, approval, rejection, gate block). Emitted by add-strict-human-approval-for-cross-repo-changes (Step 1.5).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "timestamp",
    "proposal_name",
    "hub_issue",
    "decision",
    "actor"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version. v1 introduces cross-repo decision audit records."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when decision was made"
    },
    "proposal_name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Local proposal name (kebab-case)"
    },
    "hub_issue": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+#[0-9]+$",
      "description": "Hub Issue reference (e.g. 'org/rdd-hub#42')"
    },
    "decision": {
      "type": "string",
      "enum": [
        "initiate",
        "approve",
        "reject",
        "block",
        "defer",
        "revoke"
      ],
      "description": "Type of decision recorded"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "human",
            "ai-agent",
            "ci-bot"
          ],
          "description": "Type of actor making the decision"
        },
        "id": {
          "type": "string",
          "description": "GitHub username (human) or agent ID (ai-agent)"
        }
      },
      "additionalProperties": false
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional human-readable reason for the decision"
    },
    "hub_status_at_decision": {
      "type": "string",
      "enum": [
        "Draft",
        "RFC",
        "In-Review",
        "Approved",
        "Rejected",
        "Blocked"
      ],
      "description": "Hub Issue Status at the moment of decision"
    },
    "local_gate": {
      "type": "string",
      "enum": [
        "design-done",
        "plan-done",
        "ship-done"
      ],
      "description": "Local gate affected by this decision"
    }
  }
}
