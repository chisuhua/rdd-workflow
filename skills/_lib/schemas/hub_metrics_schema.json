{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": {
    "const": "v1",
    "description": "Schema metadata version per ADR-0016. Const v1 = initial baseline. Future bumps require version-migration flow."
  },
  "$id": "https://rdd-workflow.local/schemas/hub_metrics_schema.json",
  "title": "Hub Metrics v1 (ADR-0030)",
  "description": "Schema for .rddf/state/.hub-metrics.json. Aggregate metrics for Hub-and-Spoke 3-month review. Updated by metrics-collection cron / Hub CI.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "last_updated",
    "spokes_connected",
    "rfc_stats"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when metrics were last aggregated"
    },
    "spokes_connected": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of Spoke repos actively connected to Hub (synced within 30 days)"
    },
    "rfc_stats": {
      "type": "object",
      "required": [
        "total",
        "by_status",
        "avg_decision_days"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total RFCs created since Hub inception"
        },
        "by_status": {
          "type": "object",
          "properties": {
            "Draft": {
              "type": "integer",
              "minimum": 0
            },
            "RFC": {
              "type": "integer",
              "minimum": 0
            },
            "In-Review": {
              "type": "integer",
              "minimum": 0
            },
            "Approved": {
              "type": "integer",
              "minimum": 0
            },
            "Rejected": {
              "type": "integer",
              "minimum": 0
            },
            "Blocked": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "avg_decision_days": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Average days from RFC creation to Approved/Rejected status"
        },
        "stale_rfc_count": {
          "type": "integer",
          "minimum": 0,
          "description": "RFCs with no Comment for >5 days (triggers early review)"
        }
      },
      "additionalProperties": false
    },
    "audit_anomalies": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of anomaly events in .cross-repo-audit.jsonl (decision=block failures)"
    },
    "hub_health": {
      "type": "object",
      "properties": {
        "branch_protection_enabled": {
          "type": "boolean"
        },
        "maintainer_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_security_audit": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  }
}
