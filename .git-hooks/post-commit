#!/bin/sh
# .git-hooks/post-commit — archive diff reconciliation hook
#
# Created: add-archive-post-commit-hook-and-force-flag (P0, 2026-08-05).
# Purpose: catch the "唯一漏洞" path where authors run
#   git mv openspec/changes/<name>/ openspec/changes/archive/<date>-<name>/
#   openspec archive <name> --yes
#   git commit -m "chore(archive): finalize <name> archive state"
# without invoking archive.sh::archive_change. This hook detects the
# archive dir in the commit diff and calls sync_iteration_after_archive
# to keep iteration.json consistent.
#
# Constraints (per proposal §技术约束):
#   - POSIX sh compatible (macOS + Linux)
#   - exit 0 on any failure (never block commit)
#   - stdout ≤ 3 lines
#   - no spec delta check, no secondary git commit
#
# Date-prefix detection: ^\d{4}-\d{2}-\d{2}-.+$ matches archive dir naming
# convention. The name is the substring after the date prefix.

# Locate the project's repo root. `git rev-parse --show-toplevel`
# returns the correct path for both worktrees and regular repos.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$PROJECT_ROOT" ] || [ ! -d "$PROJECT_ROOT" ]; then
    exit 0
fi

# Find newly-added archive dirs in this commit.
# `git diff-tree --no-commit-id --name-only -r HEAD` lists files changed
# in HEAD (vs HEAD~1). Match any path starting with the archive dir
# pattern (the dir itself OR any file inside it), then dedupe to one
# entry per dir.
ARCHIVE_DIRS=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
    | grep -E '^openspec/changes/archive/[0-9]{4}-[0-9]{2}-[0-9]{2}-[^/]+/' \
    | sed 's|^\(openspec/changes/archive/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-\)\([^/]*\)/.*$|\2|' \
    | sort -u)

# If no archive paths, exit silently (scenario 3: misfire protection).
if [ -z "$ARCHIVE_DIRS" ]; then
    exit 0
fi

# Get the current commit SHA for archive_commit_sha field.
COMMIT_SHA=$(git rev-parse HEAD 2>/dev/null)

# Process each detected archive dir.
echo "✅ archive hook: detected $(echo "$ARCHIVE_DIRS" | wc -l) archive change(s)"
for name in $ARCHIVE_DIRS; do
    # Validate the name (should be non-empty, alphanumeric + dash).
    if [ -z "$name" ] || ! echo "$name" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9-]*$'; then
        echo "⚠️  archive hook: skipping invalid name '$name' (extracted from path)"
        continue
    fi

    # Call sync_iteration_after_archive via Python. The helper is
    # fail-open: never raises, returns None on success or a warning
    # string on failure. We capture both stdout and stderr to keep
    # the hook's output ≤ 3 lines.
    if [ ! -d "$PROJECT_ROOT/skills/_lib/iteration" ]; then
        echo "⚠️  archive hook: skills/_lib/iteration not found at $PROJECT_ROOT; skipping $name"
        continue
    fi

    OUT=$(SKILLS_PARENT="$PROJECT_ROOT" \
          PROJECT_ROOT="$PROJECT_ROOT" \
          CHANGE_NAME="$name" \
          ARCHIVE_COMMIT_SHA="$COMMIT_SHA" \
          python3 -c '
import os, sys
sys.path.insert(0, os.environ.get("SKILLS_PARENT", "."))
try:
    from skills._lib.iteration import post_archive as pa
except ImportError as exc:
    print(f"WARN:helper_unavailable:{exc}")
    sys.exit(0)
try:
    warn = pa.sync_iteration_after_archive(
        project_root=os.environ["PROJECT_ROOT"],
        change_name=os.environ["CHANGE_NAME"],
        archive_commit_sha=os.environ.get("ARCHIVE_COMMIT_SHA") or None,
    )
    if warn:
        print(f"WARN:{warn}")
    else:
        print("OK")
except Exception as exc:
    print(f"WARN:helper_raised:{exc}")
' 2>&1)

    case "$OUT" in
        OK)              echo "✅ archive hook synced: $name" ;;
        WARN:*)          echo "⚠️  archive hook failed for $name: ${OUT#WARN:}. Run: rddf archive-sync $name" ;;
        *)               echo "⚠️  archive hook failed for $name (no output from helper)" ;;
    esac
done

# Always exit 0 — never block the commit.
exit 0
