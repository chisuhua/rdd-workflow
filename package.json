{
  "name": "rdd-workflow",
  "version": "4.0.0",
  "description": "RDD Workflow - OpenSpec 工作流技能包（propose→plan→execute→status→archive）。v2.0 自包含 TDD 计划生成与执行，无外部 skill 依赖。",
  "main": "skills/INSTALL.md",
  "author": "sisyphus",
  "license": "MIT",
  "alias": [
    "workflow",
    "install",
    "rdd-workflow"
  ],
  "keywords": [
    "rdd-workflow",
    "workflow",
    "openspec",
    "change-management",
    "cli",
    "tdd"
  ],
  "scripts": {
    "test": "npm run test:bats && npm run test:python",
    "test:bats": "bats tests/ --recursive",
    "test:python": "python3 -m pytest tests/unit/ tests/integration/ -q --tb=short",
    "test:python:verbose": "python3 -m pytest tests/unit/ tests/integration/ -v --tb=short",
    "install-python-deps": "pip install -r requirements.txt"
  },
  "engines": {
    "git": ">=2.25.0",
    "openspec-cli": ">=1.7.0"
  },
  "skills": [
    "add-improve",
    "contract-check",
    "cross-repo-protocol",
    "deps",
    "execute",
    "feature",
    "guide",
    "openspec-gate",
    "propose",
    "rdd-arch",
    "rdd-builder",
    "rdd-doctor",
    "rdd-env-bootstrap",
    "rdd-env-check",
    "rdd-hub-bootstrap",
    "rdd-planner",
    "rdd-quick",
    "rdd-verifier",
    "rdd-workflow-brainstorm",
    "rdd-workflow-writing-plans",
    "rddf-session",
    "report-issue",
    "roadmap",
    "spoke-system-prompt-injection",
    "status",
    "sync-hub",
    "watch-hub"
  ]
}